generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Project {
  id                 String               @id @default(uuid())
  orgId              String
  name               String
  slug               String?
  description        String?
  repositoryUrl      String?
  defaultBranch      String               @default("main")
  scanSettings       Json                 @default("{}")
  aiSettings         Json                 @default("{}")
  settings           Json                 @default("{}")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  chat_conversations chat_conversations[]
  chunks             Chunk[]
  documents          Document[]
  entities           Entity[]
  entityRelations    EntityRelation[]
  memories           Memory[]
  organizations      organizations        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reports            reports[]
  scan_comparisons   scan_comparisons[]
  scans              scans[]
  sessions           Session[]
  sources            Source[]

  @@unique([orgId, name])
  @@unique([orgId, slug])
  @@index([createdAt])
  @@map("projects")
}

model Source {
  id                                                       String          @id @default(uuid())
  orgId                                                    String
  projectId                                                String?
  name                                                     String
  type                                                     String
  connectorType                                            String?
  config                                                   Json            @default("{}")
  status                                                   SourceStatus    @default(PENDING)
  syncMode                                                 SyncMode        @default(MANUAL)
  syncSchedule                                             String?
  lastSyncAt                                               DateTime?
  lastSyncStatus                                           String?
  lastSyncError                                            String?
  syncError                                                String?
  syncErrorCount                                           Int             @default(0)
  documentsCount                                           Int             @default(0)
  documentCount                                            Int             @default(0)
  chunkCount                                               Int             @default(0)
  lastSyncDurationMs                                       Int?
  bytesIndexed                                             BigInt          @default(0)
  autoSync                                                 Boolean         @default(true)
  branch                                                   String?
  pathFilter                                               String?
  createdAt                                                DateTime        @default(now())
  updatedAt                                                DateTime        @updatedAt
  activeVersionId                                          String?
  deletedAt                                                DateTime?
  restoreUntil                                             DateTime?
  documents                                                Document[]
  versions                                                 SourceVersion[]
  source_versions_sources_activeVersionIdTosource_versions SourceVersion?  @relation("sources_activeVersionIdTosource_versions", fields: [activeVersionId], references: [id])
  organizations                                            organizations   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project                                                  Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sync_jobs                                                SyncJob[]
  webhooks                                                 Webhook[]

  @@unique([orgId, name])
  @@index([projectId])
  @@index([status])
  @@index([activeVersionId])
  @@index([deletedAt])
  @@index([orgId])
  @@index([syncMode])
  @@index([type])
  @@map("sources")
}

model SourceVersion {
  id                                               String              @id @default(uuid())
  sourceId                                         String
  orgId                                            String
  projectId                                        String?
  versionNumber                                    Int
  status                                           SourceVersionStatus @default(STAGED)
  syncJobId                                        String?
  partialFailure                                   Boolean             @default(false)
  warningCodes                                     String[]            @default([])
  errorCode                                        String?
  errorMessage                                     String?
  documentCount                                    Int                 @default(0)
  chunkCount                                       Int                 @default(0)
  promotedAt                                       DateTime?
  supersededAt                                     DateTime?
  failedAt                                         DateTime?
  restoreUntil                                     DateTime?
  createdAt                                        DateTime            @default(now())
  updatedAt                                        DateTime            @default(now()) @updatedAt
  documents                                        Document[]
  source                                           Source              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sources_sources_activeVersionIdTosource_versions Source[]            @relation("sources_activeVersionIdTosource_versions")

  @@unique([sourceId, versionNumber])
  @@index([sourceId, status])
  @@index([restoreUntil])
  @@index([syncJobId])
  @@map("source_versions")
}

model Document {
  id               String         @id @default(uuid())
  sourceId         String
  projectId        String?
  externalId       String?
  title            String
  path             String?
  mimeType         String?
  content          String?
  contentHash      String?
  size             BigInt         @default(0)
  language         String?
  metadata         Json           @default("{}")
  chunkingStrategy String?
  tokens           Int            @default(0)
  status           DocumentStatus @default(PENDING)
  parseError       String?
  indexedAt        DateTime?
  lastModified     DateTime?
  webUrl           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sourceVersionId  String?
  deletedAt        DateTime?
  chunks           Chunk[]
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source           Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceVersion    SourceVersion? @relation(fields: [sourceVersionId], references: [id])
  entities         Entity[]

  @@index([sourceId])
  @@index([sourceVersionId])
  @@index([contentHash])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([language])
  @@index([mimeType])
  @@map("documents")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Chunk {
  id              String                 @id @default(uuid())
  documentId      String
  projectId       String?
  chunkOrder      Int?
  chunkIndex      Int?
  chunkType       String?
  content         String
  contentHash     String?
  searchContent   String?
  tokens          Int                    @default(0)
  tokenCount      Int?
  metadata        Json                   @default("{}")
  keywords        String[]               @default([])
  importanceScore Float                  @default(0.0)
  parentChunkId   String?
  sectionPath     String?
  headingPath     String?
  rerankScore     Float?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  embedding       Unsupported("vector")?
  chunkMemories   ChunkMemory[]
  document        Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentChunk     Chunk?                 @relation("ChunkHierarchy", fields: [parentChunkId], references: [id])
  childChunks     Chunk[]                @relation("ChunkHierarchy")
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  embeddings      Embedding[]
  memories        Memory[]               @relation("MemorySourceChunk")

  @@index([documentId])
  @@index([contentHash])
  @@index([parentChunkId])
  @@index([createdAt])
  @@index([embedding])
  @@index([projectId, chunkType], map: "chunks_project_chunk_type_idx")
  @@index([projectId], map: "chunks_project_id_idx")
  @@index([sectionPath])
  @@map("chunks")
}

model Embedding {
  id           String                @id @default(uuid())
  chunkId      String
  model        String
  dimensions   Int
  vector       Unsupported("vector")
  sparseVector Json
  createdAt    DateTime              @default(now())
  chunk        Chunk                 @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([model])
  @@map("embeddings")
}

model Memory {
  id                 String                 @id @default(uuid())
  orgId              String?
  projectId          String?
  userId             String?
  sessionId          String?
  agentId            String?
  memoryType         String                 @default("GENERAL")
  content            String
  metadata           Json                   @default("{}")
  scope              String                 @default("USER")
  importance         Float                  @default(0.5)
  isActive           Boolean                @default(true)
  accessCount        Int                    @default(0)
  lastAccessedAt     DateTime?
  lastRecalledAt     DateTime?
  recallCount        Int                    @default(0)
  derivedFromId      String?
  expiresAt          DateTime?
  documentDate       DateTime?
  eventDate          DateTime?
  entityMentions     String[]               @default([])
  confidence         Float                  @default(0.8)
  sourceChunkId      String?
  version            Int                    @default(1)
  validFrom          DateTime?              @default(now())
  validUntil         DateTime?
  supersededBy       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  embedding          Unsupported("vector")?
  taskId             String?
  project            Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceChunk        Chunk?                 @relation("MemorySourceChunk", fields: [sourceChunkId], references: [id])
  supersededByMemory Memory?                @relation("MemoryVersionChain", fields: [supersededBy], references: [id])
  supersedes         Memory[]               @relation("MemoryVersionChain")
  outgoingRelations  MemoryRelation[]       @relation("MemoryFrom")
  incomingRelations  MemoryRelation[]       @relation("MemoryTo")

  @@index([projectId])
  @@index([orgId])
  @@index([userId])
  @@index([sessionId])
  @@index([agentId])
  @@index([taskId])
  @@index([memoryType])
  @@index([scope])
  @@index([isActive])
  @@index([expiresAt])
  @@index([validFrom, validUntil])
  @@index([confidence])
  @@index([supersededBy])
  @@index([documentDate, eventDate])
  @@index([embedding])
  @@index([entityMentions])
  @@index([projectId, isActive, expiresAt], map: "memories_project_active_expiry_idx")
  @@index([projectId, userId, sessionId, isActive, expiresAt], map: "memories_project_user_session_active_expiry_idx")
  @@index([sourceChunkId])
  @@map("memories")
}

model MemoryRelation {
  id           String   @id @default(uuid())
  fromMemoryId String
  toMemoryId   String
  relationType String
  confidence   Float    @default(0.8)
  reasoning    String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  fromMemory   Memory   @relation("MemoryFrom", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  toMemory     Memory   @relation("MemoryTo", fields: [toMemoryId], references: [id], onDelete: Cascade)

  @@unique([fromMemoryId, toMemoryId, relationType], map: "memory_relations_unique")
  @@index([fromMemoryId])
  @@index([toMemoryId])
  @@index([fromMemoryId, toMemoryId])
  @@index([relationType])
  @@map("memory_relations")
}

model ChunkMemory {
  id             String   @id @default(uuid())
  chunkId        String
  memoryId       String
  relevanceScore Float    @default(0.0)
  createdAt      DateTime @default(now())
  chunk          Chunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, memoryId])
  @@index([chunkId])
  @@index([memoryId])
  @@map("chunk_memories")
}

model Entity {
  id                String                 @id @default(uuid())
  documentId        String?
  projectId         String?
  name              String
  type              String
  entityType        String?
  value             String?
  description       String?
  sourceChunkId     String?
  parentId          String?
  parentPath        String?
  definitionPos     Json?
  references        Json?
  metadata          Json                   @default("{}")
  signature         String?
  accessLevel       String?
  language          String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  embedding         Unsupported("vector")?
  document          Document?              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entities          Entity?                @relation("entitiesToentities", fields: [parentId], references: [id])
  other_entities    Entity[]               @relation("entitiesToentities")
  project           Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoingRelations EntityRelation[]       @relation("EntityFrom")
  incomingRelations EntityRelation[]       @relation("EntityTo")

  @@unique([projectId, name, entityType])
  @@unique([documentId, name, type])
  @@index([type])
  @@index([documentId])
  @@index([embedding])
  @@index([name])
  @@index([parentId])
  @@index([parentPath])
  @@map("entities")
}

model EntityRelation {
  id           String   @id @default(uuid())
  projectId    String?
  fromEntityId String
  toEntityId   String
  relationType String
  weight       Float?   @default(1.0)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  fromEntity   Entity   @relation("EntityFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toEntity     Entity   @relation("EntityTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relationType])
  @@index([projectId])
  @@index([fromEntityId])
  @@index([relationType])
  @@index([toEntityId])
  @@map("entity_relations")
}

model Session {
  id            String    @id @default(uuid())
  orgId         String?
  projectId     String?
  sessionId     String?
  userId        String?
  agentId       String?
  title         String?
  systemPrompt  String?
  contextId     String?
  status        String    @default("ACTIVE")
  lastMessageAt DateTime?
  messageCount  Int       @default(0)
  maxTokens     Int?
  metadata      Json      @default("{}")
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  taskId        String?
  messages      Message[]
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([sessionId])
  @@index([agentId])
  @@index([createdAt])
  @@index([orgId])
  @@index([status])
  @@index([taskId])
  @@map("sessions")
}

model Message {
  id             String   @id @default(uuid())
  sessionId      String?
  conversationId String?
  role           String
  content        String
  toolCalls      Json?
  toolResults    Json?
  contextUsed    Json?
  tokens         Int?
  latencyMs      Int?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  session        Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([role])
  @@map("messages")
}

model SyncJob {
  id               String    @id @default(uuid())
  sourceId         String
  type             String    @default("FULL")
  status           String    @default("PENDING")
  startedAt        DateTime?
  completedAt      DateTime?
  documentsTotal   Int       @default(0)
  documentsIndexed Int       @default(0)
  documentsFailed  Int       @default(0)
  bytesProcessed   BigInt    @default(0)
  errorMessage     String?
  retryCount       Int       @default(0)
  progress         Float     @default(0.0)
  logs             Json      @default("[]")
  createdAt        DateTime  @default(now())
  sourceVersionId  String?
  partialFailure   Boolean   @default(false)
  warningCodes     String[]  @default([])
  errorCode        String?
  traceId          String?
  parentTraceId    String?
  sources          Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@map("sync_jobs")
}

model IngestionJob {
  id                  String                @id @default(uuid()) @db.VarChar(255)
  org_id              String                @db.VarChar(255)
  project_id          String                @db.VarChar(255)
  user_id             String                @db.VarChar(255)
  status              String                @default("PENDING") @db.VarChar(50)
  total_documents     Int                   @default(0)
  processed_documents Int                   @default(0)
  total_chunks        Int                   @default(0)
  processed_chunks    Int                   @default(0)
  webhook_url         String?
  metadata            Json?                 @default("{}")
  started_at          DateTime?             @db.Timestamp(6)
  completed_at        DateTime?             @db.Timestamp(6)
  error               String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  ingestion_documents ingestion_documents[]

  @@index([created_at], map: "idx_ingestion_jobs_created_at")
  @@index([org_id], map: "idx_ingestion_jobs_org_id")
  @@index([project_id], map: "idx_ingestion_jobs_project_id")
  @@index([status], map: "idx_ingestion_jobs_status")
  @@map("ingestion_jobs")
}

model ApiIdempotency {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id          String
  endpoint        String
  idempotency_key String
  request_hash    String
  status_code     Int
  response_body   Json     @default("{}")
  expires_at      DateTime @db.Timestamp(6)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)

  @@unique([org_id, endpoint, idempotency_key], map: "api_idempotency_org_endpoint_key_unique")
  @@index([expires_at])
  @@index([org_id, endpoint], map: "api_idempotency_org_endpoint_idx")
  @@map("api_idempotency")
}

model Webhook {
  id              String    @id @default(uuid())
  orgId           String
  sourceId        String?
  url             String
  secret          String?
  events          String[]
  status          String    @default("ACTIVE")
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  lastDeliveredAt DateTime?
  lastStatusCode  Int?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sources         Source?   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String   @id @default(uuid())
  webhookId     String
  event         String
  payload       Json
  statusCode    Int?
  responseBody  String?
  errorMessage  String?
  deliveredAt   DateTime @default(now())
  eventId       String?
  action        String   @default("deliver")
  attempt       Int      @default(1)
  durationMs    Int?
  errorCode     String?
  traceId       String?
  parentTraceId String?

  @@index([webhookId])
  @@index([deliveredAt])
  @@index([eventId])
  @@index([event])
  @@map("webhook_deliveries")
}

model ChunkDocument {
  id             String   @id
  chunkId        String
  documentId     String
  relevanceScore Float    @default(0.0)
  createdAt      DateTime @default(now())

  @@index([chunkId])
  @@index([documentId])
}

model DocumentChunk {
  id         String   @id
  documentId String
  chunkId    String
  position   Int
  createdAt  DateTime @default(now())

  @@unique([documentId, chunkId])
  @@index([chunkId])
  @@index([documentId])
}

model api_keys {
  id            String        @id
  keyId         String        @unique
  keyPrefix     String        @unique
  keyHash       String        @unique
  name          String
  orgId         String
  userId        String?
  scopes        String[]      @default([])
  rateLimit     Int?
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  revokedAt     DateTime?
  revoked       Boolean       @default(false)
  isActive      Boolean       @default(true)
  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users         users?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([orgId])
  @@index([revoked, expiresAt])
  @@index([userId])
}

model audit_logs {
  id            String         @id
  orgId         String?
  userId        String?
  action        String
  resource      String?
  metadata      Json           @default("{}")
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  organizations organizations? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users         users?         @relation(fields: [userId], references: [id])

  @@index([orgId, action, createdAt(sort: Desc)])
  @@index([orgId, createdAt, action])
  @@index([userId])
}

model benchmark_results {
  id               String   @id
  repoOwner        String
  repoName         String
  repoStars        Int
  repoLanguage     String
  totalFindings    Int
  criticalFindings Int
  highFindings     Int
  mediumFindings   Int
  lowFindings      Int
  scanDuration     Float
  categories       Json     @default("{}")
  scanId           String
  scannedAt        DateTime @default(now())
  competitorData   Json?
  createdAt        DateTime @default(now())

  @@index([repoOwner, repoName])
  @@index([scannedAt])
}

model billing_events {
  id            String        @id
  orgId         String
  stripeEventId String        @unique
  type          String
  payload       Json
  createdAt     DateTime      @default(now())
  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orgId, type])
}

model blog_posts {
  id           String     @id
  slug         String     @unique
  title        String
  excerpt      String
  content      String
  coverImage   String?
  author       String
  authorAvatar String?
  publishedAt  DateTime?
  featured     Boolean    @default(false)
  tags         String[]
  views        Int        @default(0)
  readTime     Int
  status       PostStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime

  @@index([publishedAt])
  @@index([slug])
  @@index([status])
}

model chat_conversations {
  id              String          @id
  userId          String
  projectId       String?
  title           String?
  contextMetadata Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  projects        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  users           users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat_messages   chat_messages[]

  @@index([createdAt])
  @@index([projectId])
  @@index([userId])
  @@index([userId, projectId, createdAt(sort: Desc)])
}

model chat_messages {
  id                 String             @id
  conversationId     String
  userId             String
  role               ChatRole
  content            String
  metadata           Json               @default("{}")
  tokensUsed         Int?
  modelUsed          String?
  createdAt          DateTime           @default(now())
  chat_conversations chat_conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  users              users              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([userId])
}

model codebase_indexes {
  id                 String   @id
  orgId              String
  projectId          String
  repoFullName       String
  treeSha            String
  indexVersion       Int      @default(2)
  functions          Json     @default("[]")
  classes            Json     @default("[]")
  imports            Json     @default("[]")
  securityControls   Json     @default("{}")
  embeddings         Json     @default("[]")
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  lastUsedAt         DateTime @default(now())
  apiContracts       Json     @default("{}")
  authGraph          Json     @default("{}")
  businessLogic      Json     @default("{}")
  codeQuality        Json     @default("{}")
  configPatterns     Json     @default("{}")
  dataFlowPaths      Json     @default("[]")
  databaseSchema     Json     @default("{}")
  dependencySecurity Json     @default("{}")
  domainEntities     Json     @default("[]")
  errorHandling      Json     @default("{}")
  performanceHints   Json     @default("{}")
  runtimePatterns    Json     @default("{}")
  testCoverage       Json     @default("{}")
  typeSystem         Json     @default("{}")

  @@unique([projectId, treeSha])
  @@index([orgId, projectId])
  @@index([repoFullName])
}

model codebase_knowledge {
  id         String   @id
  orgId      String
  projectId  String
  category   String
  key        String
  value      Json
  embedding  Json?
  confidence Float    @default(0.8)
  source     String   @default("auto")
  usageCount Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([projectId, category, key])
  @@index([category])
  @@index([orgId, projectId])
}

model device_codes {
  id           String    @id
  deviceCode   String    @unique
  userCode     String    @unique
  userId       String?
  apiKey       String?
  status       String    @default("pending")
  expiresAt    DateTime
  authorizedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([deviceCode])
  @@index([status, expiresAt])
  @@index([userCode])
}

model docs {
  id        String   @id
  slug      String   @unique
  title     String
  content   String
  category  String
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category])
  @@index([slug])
}

model embedding_jobs {
  id               String    @id @db.VarChar(255)
  document_id      String?   @db.VarChar(255)
  chunk_ids        Json?     @default("[]")
  status           String    @default("PENDING") @db.VarChar(50)
  total_chunks     Int       @default(0)
