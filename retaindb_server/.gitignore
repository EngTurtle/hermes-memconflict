# RetainDB server edition: the gitignored build dir serve_local.sh copies the
# external/RetainDB submodule into (never built in-place under external/). Holds
# node_modules + the tsup/prisma build; fully regenerated by serve_local.sh.
.server_build/

# Transient run junk. Results/Scores are otherwise COMMITTED (final result/score
# JSONL + summary JSON), matching how retaindb/ tracks its artifacts; only logs
# and intermediate shard/db scratch are ignored (the repo-root .gitignore already
# covers */Results/shards/, */Results/*.log, */Scores/*.log across all providers).
*.log
__pycache__/
